FROM python:3.11-slim-bookworm

# ---------------------------------------------------------------------------
# ERPNext Dockerfile — Pinned versions + verified patches
#
# Frappe:  v15.120.0 (commit 755b5cb)
# ERPNext: v15.121.0 (commit 1a0bf0b)
#
# All patches are verified after application. If a patch fails to apply,
# the build will fail with a clear error message indicating the upstream
# code has changed and the patch needs updating.
# ---------------------------------------------------------------------------

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    libmariadb-dev \
    nodejs \
    npm \
    git \
    curl \
    cron \
    mariadb-client \
    postgresql-client \
    redis-server \
    redis-tools \
    pkg-config \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g yarn

RUN pip3 install --break-system-packages frappe-bench

RUN useradd -ms /bin/bash frappe

USER frappe
WORKDIR /home/frappe

# --- Pin Frappe to v15.120.0 ---
RUN bench init \
    --frappe-branch v15.120.0 \
    --skip-redis-config-generation \
    --skip-assets \
    bench-dir

WORKDIR /home/frappe/bench-dir

# --- Pin ERPNext to v15.121.0 ---
RUN bench get-app --branch v15.121.0 erpnext

# ===========================================================================
# PATCH 1: Database driver — use db_user from site_config.json
# ===========================================================================
RUN sed -i 's/user=local.conf.db_name or db_name/user=local.conf.get("db_user") or local.conf.db_name or db_name/g' \
    /home/frappe/bench-dir/apps/frappe/frappe/__init__.py

# Verify patch 1 applied
RUN grep -q 'local.conf.get("db_user") or local.conf.db_name or db_name' \
    /home/frappe/bench-dir/apps/frappe/frappe/__init__.py || \
    (echo "PATCH 1 FAILED: db_user patch did not apply. Upstream code may have changed." && exit 1)

# ===========================================================================
# PATCH 2: Add get_admin_session endpoint for proxy login bypass
# SECURITY: ERP_PROXY_SECRET must be set via environment variable at runtime
# ===========================================================================
RUN printf '\n@frappe.whitelist(allow_guest=True)\ndef get_admin_session():\n    import os\n    import frappe\n    proxy_secret = frappe.get_request_header("X-Proxy-Secret")\n    expected_secret = os.environ.get("ERP_PROXY_SECRET", "")\n    if not expected_secret:\n        frappe.local.response["http_status_code"] = 500\n        return {"error": "ERP_PROXY_SECRET not configured"}\n    if not proxy_secret or proxy_secret != expected_secret:\n        frappe.local.response["http_status_code"] = 403\n        return {"error": "Unauthorized"}\n    try:\n        frappe.db.set_value("User", "Administrator", "desk_theme", "Dark")\n        frappe.db.commit()\n    except Exception:\n        pass\n    from frappe.auth import LoginManager\n    frappe.local.login_manager = LoginManager()\n    frappe.local.login_manager.user = "Administrator"\n    frappe.local.login_manager.post_login()\n    return {"sid": frappe.session.sid}\n' \
    >> /home/frappe/bench-dir/apps/frappe/frappe/auth.py

# Verify patch 2 applied
RUN grep -q 'def get_admin_session' \
    /home/frappe/bench-dir/apps/frappe/frappe/auth.py || \
    (echo "PATCH 2 FAILED: get_admin_session endpoint did not apply." && exit 1)

# ===========================================================================
# PATCH 3: Cookie security — SameSite=None, Secure=True for cross-origin iframe
# ===========================================================================
RUN sed -i 's/secure=False,/secure=True,/g' \
    /home/frappe/bench-dir/apps/frappe/frappe/auth.py && \
    sed -i 's/samesite="Lax",/samesite="None",/g' \
    /home/frappe/bench-dir/apps/frappe/frappe/auth.py

# Verify patch 3 applied (check for SameSite=None)
RUN grep -q 'samesite="None"' \
    /home/frappe/bench-dir/apps/frappe/frappe/auth.py || \
    (echo "PATCH 3 FAILED: Cookie security patch did not apply." && exit 1)

# ===========================================================================
# Build assets
# ===========================================================================
RUN bench build

# Setup entrypoint and init scripts
USER root
COPY docker/entrypoint.sh /home/frappe/entrypoint.sh
COPY docker/init_site.py /home/frappe/init_site.py
COPY docker/wsgi.py /home/frappe/bench-dir/wsgi.py
COPY docker/test_erpnext_supabase.py /home/frappe/test_erpnext_supabase.py
RUN chmod +x /home/frappe/entrypoint.sh && \
    chown frappe:frappe /home/frappe/entrypoint.sh /home/frappe/init_site.py /home/frappe/bench-dir/wsgi.py /home/frappe/test_erpnext_supabase.py

USER frappe

EXPOSE 8080

ENTRYPOINT ["/home/frappe/entrypoint.sh"]
